# Drone Security Analyst Agent Configuration
APP_ENV=development
APP_NAME=Drone Security Analyst Agent
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./data/drone.db

# VLM Configuration
VLM_PROVIDER=mock
VLM_MODEL=mock-security-vlm-v1
GEMINI_API_KEY=

# Pipeline Configuration
PIPELINE_INTERVAL_SECONDS=1.0
PIPELINE_AUTO_START=false

# Alert & Detection Thresholds
LOITERING_MIN_FRAMES=2
CONFIDENCE_THRESHOLD=0.70
